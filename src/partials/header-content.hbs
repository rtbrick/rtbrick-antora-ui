<header class="header">
  <nav class="navbar">
    <div class="navbar-brand">
      <a class="navbar-item rtb-brand" href="https://rtbrick.com/">
        <img class="rtb-logo" src="{{{uiRootPath}}}/img/rtbrick-logo.svg" alt="RtBrick Logo" width="193" height="34">
      </a>
      <a class="navbar-item title is-hidden-desktop" href="{{{relativize page.componentVersion.url}}}">
        {{page.componentVersion.title}}
      </a>
      <button class="navbar-burger" aria-controls="topbar-nav" aria-expanded="false" aria-label="Toggle main menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <div id="topbar-nav" class="navbar-menu">
      <div class="navbar-end">
        <a class="navbar-item" href="/">Home</a>
        {{#if (morethan site.components 3)}}
        <div class="navbar-item has-dropdown is-hoverable">
          <span class="navbar-link">Projects</span>
          <div class="navbar-dropdown">
            {{#each (componentSorter site.components page.attributes.component-sort-order)}}
            <a class="navbar-item" href="{{{relativize ./url}}}">{{{./title}}}</a>
            {{/each}}
          </div>
        </div>
        {{else}}
        {{#each (componentSorter site.components page.attributes.component-sort-order)}}
        <a class="navbar-item" href="{{{relativize ./url}}}">{{{./title}}}</a>
        {{/each}}
        {{/if}}
        <div class="navbar-item"></div>
        <div class="navbar-divider"></div>
        {{#if env.SITE_SEARCH_PROVIDER}}
        <div class="navbar-item search hide-for-print">
          <div id="search-field" class="field has-filter">
            <input id="search-input" type="text" placeholder="Search the docs" {{#if page.home}} autofocus{{/if}}>
            <label class="filter checkbox">
              <input type="checkbox" data-facet-filter="version:{{page.version}}" checked>In this version
            </label>
          </div>
        </div>
        {{else}}
        {{!-- Typesense search --}}
        <div class="navbar-item search hide-for-print">
          <div id="searchbar" style="margin-left: -16px"></div>
          <input type="checkbox" id="version-filter-check" style="cursor: pointer;" checked>
          <label for="version-filter-check" style="cursor: pointer;">In this version</label>
        </div>
        {{/if}}
      </div>
    </div>
  </nav>
</header>